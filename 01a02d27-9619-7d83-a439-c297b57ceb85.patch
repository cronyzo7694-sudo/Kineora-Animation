++/** One hostile input per roll: raw garbage string, or a plan-shaped JSON doc. */
++function hostileInput(rng: () => number): string {
++  if (rng() < 0.2) {
++    // Not-necessarily-JSON byte soup (still valid UTF-16 text).
++    let s = ''
++    const n = Math.floor(rng() * 40)
