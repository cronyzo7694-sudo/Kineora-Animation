++    case 'selection.set':
++    case 'selection.clear':
++    case 'scene.inspect':
++    case 'playback.gotoFrame':
++      return { total: 0, deletedNodes: 0 }
++    default:
++      return { total: 1, deletedNodes: 0 }
++  }
++}
