{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kineora Animation",
  "version": "0.1.0",
  "identifier": "dev.kineora.animation",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kineora Animation",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign"
  }
}
