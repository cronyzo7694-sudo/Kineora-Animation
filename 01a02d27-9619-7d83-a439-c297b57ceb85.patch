++    return arr
++  }
++  const obj: Record<string, unknown> = {}
++  const n = Math.floor(rng() * 3)
++  for (let i = 0; i < n; i++) obj[pick(rng, PARAM_NAMES)] = hostileValue(rng, depth + 1)
++  return obj
++}
