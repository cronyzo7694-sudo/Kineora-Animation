++    case 'playback.gotoFrame': return `goto frame ${String(p.frame)}`
++    default: {
++      // Generic family fallback — new capability actions still get readable rows.
++      return `${cap.action} ${Object.entries(p)
++        .map(([k, v]) => `${k}=${refText(v)}`)
++        .join(' ')}`
++    }
++  }
++}
