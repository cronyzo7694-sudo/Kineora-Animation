++/// E-AI-4: monotonic document revision (0 when no document is open).
++#[wasm_bindgen]
++pub fn kineora_doc_revision() -> u64 {
++    DOCS.with(|d| {
++        let m = d.borrow();
++        m.active().map(|doc| doc.session.doc_revision()).unwrap_or(0)
++    })
++}
